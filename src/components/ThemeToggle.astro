---
// Light / dark / system switch. State lives in the inline resolver in
// MainHead.astro (window.__theme); this only reflects and sets it.
const options = [
  { value: "light", label: "Light theme" },
  { value: "dark", label: "Dark theme" },
  { value: "system", label: "Match system theme" },
] as const;
---

<div
  class="theme-toggle inline-flex items-center gap-0.5 rounded-full border border-neutral-200 p-0.5"
  role="group"
  aria-label="Color theme"
>
  {
    options.map(({ value, label }) => (
      <button
        type="button"
        data-theme-option={value}
        aria-label={label}
        aria-pressed="false"
        title={label}
        class="rounded-full p-1.5 text-neutral-500 transition duration-200 ease-in-out hover:text-neutral-800 focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-1 focus-visible:outline-neutral-800 aria-pressed:bg-neutral-800/5 aria-pressed:text-neutral-800"
      >
        <svg
          class="h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          {value === "light" && (
            <>
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
            </>
          )}
          {value === "dark" && (
            <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" />
          )}
          {value === "system" && (
            <>
              <rect x="3" y="4" width="18" height="12" rx="1.5" />
              <path d="M8 20h8M12 16v4" />
            </>
          )}
        </svg>
      </button>
    ))
  }
</div>

<script>
  type Pref = "light" | "dark" | "system";
  type ThemeApi = { read: () => Pref; set: (pref: Pref) => void };
  const api = () => (window as unknown as { __theme?: ThemeApi }).__theme;

  const sync = () => {
    const pref = api()?.read() ?? "system";
    document
      .querySelectorAll<HTMLButtonElement>("[data-theme-option]")
      .forEach((btn) =>
        btn.setAttribute("aria-pressed", String(btn.dataset.themeOption === pref)),
      );
  };

  // Delegated, so it survives ClientRouter swaps without re-binding.
  document.addEventListener("click", (e) => {
    const btn = (e.target as Element | null)?.closest<HTMLButtonElement>(
      "[data-theme-option]",
    );
    if (!btn) return;
    api()?.set(btn.dataset.themeOption as Pref);
    sync();
  });
  document.addEventListener("themechange", sync);
  document.addEventListener("astro:page-load", sync);
  sync();
</script>
