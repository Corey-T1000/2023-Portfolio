<path d="M645.494 123.079C653.092 123.079 660.561 120.491 665.196 115.573L665.325 121.785H683.355V21.7542H663.008V41.2946C663.008 46.9884 663.136 52.4234 663.394 57.729C658.63 53.8469 652.19 51.9057 645.494 51.9057C627.079 51.9057 611.496 66.3993 611.496 87.4924C611.496 108.586 627.079 123.079 645.494 123.079ZM631.843 87.4924C631.843 77.1399 638.797 70.5403 648.198 70.5403C657.47 70.5403 664.296 77.1399 664.296 87.4924C664.296 97.8448 657.47 104.445 648.198 104.445C638.797 104.445 631.843 97.8448 631.843 87.4924Z" fill="#F1F0F2"/>
</svg>
      </span>
      <button class="azt-reset" type="button" data-azt-reset>Reset</button>
    </div>

    <div
      class="azt-clip"
      data-azt-clip
      role="group"
      aria-label="Headline preview. When enlarged, drag it or use the arrow keys to move around it."
    >
      <p class="azt-type" data-azt-type>
        <span class="azt-a">AI Moves Fast.</span>
        <span class="azt-b">Permissions Must Keep Up.</span>
      </p>
    </div>

    <div class="azt-controls">
      {
        controls.map((a) => (
          <label class="azt-ctl">
            <span class="azt-row">
              <span class="azt-name">{a.label}</span>
              <span class="azt-val" aria-hidden="true" data-azt-val>
                {`${a.value}${a.unit}`}
              </span>
            </span>
            <input
              class="azt-range"
              type="range"
              autocomplete="off"
              min={a.min}
              max={a.max}
              step={a.step}
              value={a.value}
              data-azt-control={a.key}
              data-azt-unit={a.unit}
              aria-label={a.label}
              aria-valuetext={`${a.value}${a.unit === "%" ? " percent" : ""}`}
            />
          </label>
        ))
      }
    </div>
  </div>
</section>

<style>
  @font-face {
    font-family: "AuthZed Display Tester";
    src: url("/fonts/authzed-display-subset.woff2") format("woff2");
    font-weight: 300 600;
    font-stretch: 58.5% 165%;
    font-display: block;
  }

  .azt {
    container-type: inline-size;
    background: #0c050f;
    color: #f7f7f7;
    width: 100%;
  }
  .azt-in {
    --azt-pad: clamp(20px, 4.8cqi, 40px);
    --azt-measure: calc(100cqi - 2 * var(--azt-pad));
    --azt-fs: min(calc(var(--azt-measure) * 0.0943), 92px);
    padding: var(--azt-pad);
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 3.2cqi, 28px);
  }
  .azt-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .azt-logo {
    display: block;
    line-height: 0;
  }
  .azt-logo :global(svg) {
    display: block;
    width: auto;
    height: clamp(22px, 3.4cqi, 28px);
  }
  .azt-reset {
    appearance: none;
    background: transparent;
    color: #c7c4ca;
    border: 1px solid rgb(233 201 161 / 0.32);
    border-radius: 999px;
    padding: 7px 14px;
    min-height: 34px;
    font: 400 11px/1 "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }
  @media (hover: hover) {
    .azt-reset:hover {
      color: #ffffff;
      border-color: #ffb370;
    }
    .azt-range:hover::-webkit-slider-thumb {
      background: #ffc999;
    }
    .azt-range:hover::-moz-range-thumb {
      background: #ffc999;
    }
  }
  .azt-reset:focus-visible {
    outline: 2px solid #ffb370;
    outline-offset: 2px;
  }

  /* The size is a fixed share of the measure, so the line breaks are the same in any tile. The
     widest line at the widest, heaviest setting is 10.46em, so 1 / 10.6 always fits, and the
     headline never takes more than three lines. Those three lines set the window's height, so
     nothing below it moves. Size grows the type and its measure together, which keeps the line
     breaks, and the window crops it, out to the tile's edges. */
  .azt-clip {
    height: calc(var(--azt-fs) * 3.3);
    margin-inline: calc(-1 * var(--azt-pad));
    padding-inline: var(--azt-pad);
    overflow: hidden;
    touch-action: pan-y;
  }
  /* Only when there's somewhere to go. The window then keeps its touches for panning; a swipe
     anywhere outside it still scrolls the page. */
  .azt-clip.is-pannable {
    cursor: grab;
    touch-action: none;
  }
  .azt-clip.is-pannable .azt-type {
    -webkit-user-select: none;
    user-select: none;
  }
  .azt-clip.is-panning {
    cursor: grabbing;
  }
  .azt-clip:focus-visible {
    outline: 2px solid #ffb370;
    outline-offset: -2px;
  }
  .azt-type {
    width: calc(var(--azt-measure) * var(--azt-zoom, 100) / 100);
    margin: 0;
    font-family: "AuthZed Display Tester", sans-serif;
    font-synthesis: none;
    font-size: calc(var(--azt-fs) * var(--azt-zoom, 100) / 100);
    font-weight: 340;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #f7f7f7;
    font-variation-settings:
      "wght" var(--azt-wght, 340),
      "wdth" var(--azt-wdth, 100),
      "NTCH" var(--azt-NTCH, 100);
  }
  .azt-a,
  .azt-b {
    display: block;
  }
  .azt-b {
    background-image: linear-gradient(to bottom right, #ffb370, #f9808a 45%, #6242e0);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.15em;
    text-wrap: balance; /* never a lone "Up." */
  }

  .azt-controls {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 4px 24px;
  }
  @container (max-width: 720px) {
    .azt-controls {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @container (max-width: 480px) {
    .azt-controls {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .azt-ctl {
    display: block;
    min-width: 0;
  }
  .azt-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font: 400 11px/1.3 "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .azt-name {
    color: #aaa5ac;
  }
  .azt-val {
    color: #f7f7f7;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  /* The whole 40px box takes the pointer; the track only draws as a hairline. */
  .azt-range {
    appearance: none;
    -webkit-appearance: none;
    display: block;
    width: 100%;
    height: 40px;
    margin: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    touch-action: pan-y;
  }
  .azt-range::-webkit-slider-runnable-track {
    height: 1px;
    background: rgb(233 201 161 / 0.42);
  }
  .azt-range::-moz-range-track {
    height: 1px;
    background: rgb(233 201 161 / 0.42);
  }
  .azt-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    margin-top: -7.5px;
    border: 0;
    border-radius: 50%;
    background: #ffb370;
  }
  .azt-range::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: 0;
    border-radius: 50%;
    background: #ffb370;
  }
  .azt-range:active::-webkit-slider-thumb {
    background: #ffc999;
  }
  .azt-range:active::-moz-range-thumb {
    background: #ffc999;
  }
  /* The ring goes on the thumb: around the 40px box it would cut through the label. */
  .azt-range:focus-visible {
    outline: none;
  }
  .azt-range:focus-visible::-webkit-slider-thumb {
    box-shadow:
      0 0 0 3px #0c050f,
      0 0 0 5px #ffb370;
  }
  .azt-range:focus-visible::-moz-range-thumb {
    box-shadow:
      0 0 0 3px #0c050f,
      0 0 0 5px #ffb370;
  }

  @media (forced-colors: active) {
    .azt-b {
      background-image: none;
      color: CanvasText;
    }
  }
</style>

<script>
  function bind(root: HTMLElement) {
    if (root.dataset.aztBound) return;
    root.dataset.aztBound = "1";
    const type = root.querySelector<HTMLElement>("[data-azt-type]")!;
    const clip = root.querySelector<HTMLElement>("[data-azt-clip]")!;
    const inputs = [...root.querySelectorAll<HTMLInputElement>("[data-azt-control]")];
    let panX = 0;
    let panY = 0;

    // How far the type can move: its last letter to the window's right margin, its last descender
    // to the window's bottom (the gradient's bottom padding doesn't count). It's measured from the
    // live text, as every slider changes this.
    const limits = () => {
      const start = type.getBoundingClientRect().left;
      const margin = parseFloat(getComputedStyle(clip).paddingLeft);
      const spare = parseFloat(getComputedStyle(type.lastElementChild!).paddingBottom);
      let right = 0;
      for (const line of type.children) {
        const range = document.createRange();
        range.selectNodeContents(line);
        for (const rect of range.getClientRects()) right = Math.max(right, rect.right - start);
      }
      return {
        x: Math.min(0, clip.clientWidth - 2 * margin - right),
        y: Math.min(0, clip.clientHeight - type.offsetHeight + spare),
      };
    };
    const panTo = (x: number, y: number) => {
      const min = limits();
      panX = Math.round(Math.min(0, Math.max(min.x, x)));
      panY = Math.round(Math.min(0, Math.max(min.y, y)));
      type.style.transform = panX || panY ? `translate(${panX}px, ${panY}px)` : "";
      const pannable = min.x < 0 || min.y < 0;
      clip.classList.toggle("is-pannable", pannable);
      if (pannable) clip.tabIndex = 0;
      else clip.removeAttribute("tabindex");
    };

    const apply = (input: HTMLInputElement) => {
      const unit = input.dataset.aztUnit ?? "";
      type.style.setProperty(`--azt-${input.dataset.aztControl}`, input.value);
      const val = input.closest("label")?.querySelector("[data-azt-val]");
      if (val) val.textContent = `${input.value}${unit}`;
      input.setAttribute("aria-valuetext", `${input.value}${unit === "%" ? " percent" : ""}`);
    };
    // Changing Size keeps the same letters at the window's top left.
    let zoom = 100;
    const update = (input: HTMLInputElement) => {
      apply(input);
      if (input.dataset.aztControl === "zoom") {
        const next = Number(input.value);
        panTo((panX * next) / zoom, (panY * next) / zoom);
        zoom = next;
      } else {
        panTo(panX, panY);
      }
    };

    for (const input of inputs) {
      input.addEventListener("input", () => update(input));
      // Touching a track jumps the thumb there. If that touch turns out to be a page scroll,
      // the browser cancels the pointer, so put the value back.
      let before = input.value;
      input.addEventListener("pointerdown", () => (before = input.value));
      input.addEventListener("pointercancel", () => {
        input.value = before;
        update(input);
      });
      // a reload can restore the sliders without firing input
      update(input);
    }

    let drag: { id: number; x: number; y: number } | null = null;
    clip.addEventListener("pointerdown", (e: PointerEvent) => {
      if (!clip.classList.contains("is-pannable") || e.button !== 0) return;
      drag = { id: e.pointerId, x: e.clientX - panX, y: e.clientY - panY };
      clip.setPointerCapture(e.pointerId);
      clip.classList.add("is-panning");
    });
    clip.addEventListener("pointermove", (e: PointerEvent) => {
      if (drag?.id === e.pointerId) panTo(e.clientX - drag.x, e.clientY - drag.y);
    });
    const endDrag = () => {
      drag = null;
      clip.classList.remove("is-panning");
    };
    clip.addEventListener("pointerup", endDrag);
    clip.addEventListener("pointercancel", endDrag);

    const STEPS: Record<string, [number, number]> = {
      ArrowLeft: [40, 0],
      ArrowRight: [-40, 0],
      ArrowUp: [0, 40],
      ArrowDown: [0, -40],
    };
    clip.addEventListener("keydown", (e: KeyboardEvent) => {
      const step = STEPS[e.key];
      if (!step || !clip.classList.contains("is-pannable")) return;
      e.preventDefault();
      panTo(panX + step[0], panY + step[1]);
    });

    // The tile can change width, and the font's arrival changes the text's measure.
    new ResizeObserver(() => panTo(panX, panY)).observe(clip);
    document.fonts?.ready.then(() => panTo(panX, panY));
    root.querySelector("[data-azt-reset]")?.addEventListener("click", () => {
      for (const input of inputs) {
        input.value = input.defaultValue;
        apply(input);
      }
      zoom = 100;
      panTo(0, 0);
    });
  }

  const init = () => document.querySelectorAll<HTMLElement>("[data-azt]").forEach(bind);
  document.addEventListener("astro:page-load", init);
  init();
</script>
