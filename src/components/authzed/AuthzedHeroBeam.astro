---
// The AuthZed hero: the still image, with a live layer on top that sends
// pings out from random checks along the line. Each check a wave reaches
// lights up, and waves pass behind the mark. The still is what shows without JS or under reduced motion.
import { Image } from "astro:assets";
import hero from "../../assets/authzed/authzedOG@2x.jpg";
---

<div class="hero-beam relative col-span-full mb-8 md:col-span-6">
  <Image
    src={hero}
    format="jpeg"
    quality={92}
    alt="The AuthZed mark on a dark ground, at the center of a warm gradient line crossed by fine vertical ticks. The line fades out behind the mark."
    class="block w-full"
  />
  <canvas class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
</div>

<script>
  // Same drawing space and seed as the still, so the ticks land exactly on it.
  const W = 1464;
  const H = 769;
  const cx = W / 2;
  const cy = H / 2;
  const CLEAR = 100; // no ticks closer to the center than this
  const FADE_IN = 105; // the mark's edge: the pulse is gone by here
  const FADE_OUT = 200;
  const TICKS = 45;

  const STOPS = [
    [255, 179, 112],
    [249, 128, 138],
    [98, 66, 224],
  ];
  const clamp = (n: number) => Math.min(1, Math.max(0, n));
  const warm = (t: number) => {
    const u = clamp(t);
    const [a, c, k] = u < 0.5 ? [STOPS[0], STOPS[1], u * 2] : [STOPS[1], STOPS[2], (u - 0.5) * 2];
    return a.map((x, i) => Math.round(x + (c[i] - x) * (k as number)));
  };
  const rgba = (c: number[], a: number) => `rgba(${c[0]},${c[1]},${c[2]},${a})`;
  const fade = (x: number) => {
    const k = clamp((Math.abs(x - cx) - FADE_IN) / (FADE_OUT - FADE_IN));
    return k * k * (3 - 2 * k);
  };

  let seed = 11;
  const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
  const ticks: { x: number; up: number; down: number; hot: boolean; c: number[] }[] = [];
  for (let i = 0; i < TICKS; i++) {
    const x = ((i + 0.5) * W) / TICKS;
    const d = Math.abs(x - cx);
    const u = clamp((d - 178) / (W / 2 - 178));
    const e = Math.sin((1 - u) * Math.PI * 0.62 + 0.12);
    const up = (50 + 250 * e) * (0.55 + 0.45 * rnd());
    const down = (50 + 250 * e) * (0.55 + 0.45 * rnd());
    const hot = rnd() < 0.2;
    if (d >= CLEAR) ticks.push({ x, up, down, hot, c: warm(x / W) });
  }

  const LINE = [
    { w: 3, a: 1 },
    { w: 8, a: 0.24 },
    { w: 16, a: 0.1 },
    { w: 28, a: 0.05 },
  ];

  // Pings start at a random check and spread both ways along the line, dimming
  // with distance. A new one fires every second or two, so they overlap.
  const SPEED = 0.3; // drawing units per ms
  const TAIL = 240;
  const LEAD = 36;
  type Ping = { x: number; t0: number; reach: number; gain: number };
  const origins = ticks.filter((t) => Math.abs(t.x - cx) > 200);
  const spawn = (pings: Ping[], now: number) => {
    const o = origins[Math.floor(Math.random() * origins.length)];
    pings.push({ x: o.x, t0: now, reach: 320 + Math.random() * 420, gain: 0.7 + 0.3 * Math.random() });
    return now + 600 + Math.random() * 1600;
  };

  function drawPing(g: CanvasRenderingContext2D, p: Ping, now: number) {
    const r = (now - p.t0) * SPEED;
    const amp = p.gain * Math.exp(-r / p.reach);

    // The flash where it starts.
    if (r < 160) {
      const c = warm(p.x / W);
      g.strokeStyle = rgba(c, (1 - r / 160) * p.gain);
      g.lineWidth = 1.6;
      g.beginPath();
      g.arc(p.x, cy, 3 + r * 0.12, 0, 7);
      g.stroke();
    }

    // Two wavefronts on the line, each with a tail back toward the origin.
    for (const dir of [-1, 1]) {
      const head = p.x + dir * r;
      const xa = head - dir * Math.min(TAIL, r);
      const xb = head + dir * LEAD;
      if (Math.abs(xb - xa) < 1) continue;
      for (const { w, a } of LINE) {
        const l = g.createLinearGradient(xa, 0, xb, 0);
        for (let i = 0; i <= 20; i++) {
          const t = i / 20;
          const x = xa + (xb - xa) * t;
          const s = (x - xa) / (head - xa || 1);
          const shape = s <= 1 ? Math.pow(Math.max(0, s), 2.2) : 1 - Math.abs(x - head) / LEAD;
          l.addColorStop(t, rgba(warm(x / W), a * shape * amp * fade(x)));
        }
        g.fillStyle = l;
        g.fillRect(Math.min(xa, xb), cy - w / 2, Math.abs(xb - xa), w);
      }
    }

    // Each check lights from the line outward as a wavefront reaches it.
    for (const t of ticks) {
      const d = Math.abs(t.x - p.x);
      const since = r - d;
      if (since < 0 || since > 700) continue;
      const rise = clamp(since / 170);
      const k = Math.exp(-since / 240) * p.gain * Math.exp(-d / p.reach);
      if (k < 0.01) continue;
      for (const [dir, hh] of [
        [-1, t.up],
        [1, t.down],
      ]) {
        const tip = cy + dir * hh * rise;
        const l = g.createLinearGradient(0, cy, 0, tip);
        l.addColorStop(0, rgba(t.c, k * 0.9));
        l.addColorStop(1, rgba(t.c, k * (t.hot ? 0.75 : 0.45)));
        g.strokeStyle = l;
        g.lineWidth = t.hot ? 1.8 : 1.3;
        g.beginPath();
        g.moveTo(t.x, cy);
        g.lineTo(t.x, tip);
        g.stroke();
        if (rise < 1 || t.hot) {
          g.fillStyle = rgba(t.c, k);
          g.beginPath();
          g.arc(t.x, tip, t.hot ? 2.6 : 1.8, 0, 7);
          g.fill();
        }
      }
      g.strokeStyle = rgba(t.c, k);
      g.lineWidth = 1.4;
      g.beginPath();
      g.arc(t.x, cy, 3.2, 0, 7);
      g.stroke();
    }
  }

  function draw(g: CanvasRenderingContext2D, pings: Ping[], now: number) {
    g.clearRect(0, 0, W, H);
    g.globalCompositeOperation = "lighter";
    for (let i = pings.length - 1; i >= 0; i--) {
      const p = pings[i];
      if ((now - p.t0) * SPEED > p.reach * 4 + 700) pings.splice(i, 1);
      else drawPing(g, p, now);
    }
  }

  document.addEventListener("astro:page-load", () => {
    const root = document.querySelector(".hero-beam");
    const canvas = root?.querySelector("canvas");
    const g = canvas?.getContext("2d");
    if (!root || !canvas || !g) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const size = () => {
      const r = canvas.getBoundingClientRect();
      const dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.round(r.width * dpr);
      canvas.height = Math.round(r.height * dpr);
      g.setTransform(canvas.width / W, 0, 0, canvas.height / H, 0, 0);
    };
    size();
    const ro = new ResizeObserver(size);
    ro.observe(canvas);

    let raf = 0;
    let elapsed = 0;
    let last = 0;
    const pings: Ping[] = [];
    let nextAt = spawn(pings, 0);
    const frame = (now: number) => {
      elapsed += now - (last || now);
      last = now;
      if (elapsed >= nextAt) nextAt = spawn(pings, elapsed);
      draw(g, pings, elapsed);
      raf = requestAnimationFrame(frame);
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
      last = 0;
    };
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !raf) raf = requestAnimationFrame(frame);
      else if (!e.isIntersecting) stop();
    });
    io.observe(root);
    document.addEventListener(
      "astro:before-swap",
      () => {
        stop();
        io.disconnect();
        ro.disconnect();
      },
      { once: true },
    );
  });
</script>
