---
// The Sandworm system at a glance: its voice, color, gradients, type and
// diagram language, drawn with the real tokens. Values trace to the
// authzed/design repo through ./sandworm-tokens.ts and sandworm/DESIGN.md.
// Drops into a `grid-cols-6` case-study row (col-span-full).
import { PALETTE } from "./sandworm-tokens";

const SITE = "https://design-authzed.vercel.app";
const order = ["sand", "red", "magenta", "violet", "teal", "blue", "stone"] as const;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=JetBrains+Mono:wght@300;400;500&display=swap"
/>

<section class="ov col-span-full px-8 pb-4 sm:px-4" aria-label="The Sandworm design system at a glance">
  <div class="ov-board">
    <header class="ov-head">
      <p class="ov-title"><span class="font-light">The Sandworm</span> <span class="font-semibold">system</span></p>
      <a class="ov-link" href={SITE} target="_blank" rel="noopener">See the full system ↗</a>
    </header>

    <div class="ov-grid">
      <div class="ov-cell ov-voice">
        <p class="ov-h"><span class="font-light">AI Moves Fast.</span><br /><span class="font-semibold">Permissions Must Keep Up.</span></p>
        <p class="ov-sub">The Authorization Platform for AI and Modern Applications</p>
        <span class="ov-label">The homepage headline</span>
      </div>

      <div class="ov-cell ov-color">
        <div class="ov-ramps" aria-hidden="true">
          {
            order.map((family) => (
              <div class="ov-ramp">
                {PALETTE[family].map((h) => <i style={`background:${h}`} />)}
              </div>
            ))
          }
        </div>
        <span class="ov-label">Seven families with fifteen even perception-based stops</span>
      </div>

      <div class="ov-cell ov-grads">
        <div class="ov-grad" style="background:linear-gradient(100deg,#ffb370 0%,#f9808a 50%,#6242e0 100%)"></div>
        <div class="ov-grad" style="background:linear-gradient(100deg,#7a5ce6 0%,#72b1ad 100%)"></div>
      </div>

      <div class="ov-cell ov-type">
        <div class="ov-glyphs" aria-hidden="true"><span class="font-light">Aa</span><span class="font-semibold">Aa</span><span class="ov-glyph-mono">{"{}"}</span></div>
      </div>

      <div class="ov-cell ov-diagram">
        <svg viewBox="0 0 520 190" role="img" aria-label="A Sandworm diagram: a request crosses the gradient checkpoint beam, one path allowed in teal, one denied in red">
          <defs>
            <linearGradient id="ov-warm-hero" x1="0" x2="1" y1="0" y2="0">
              <stop offset="0" stop-color="#ffb370"></stop>
              <stop offset=".5" stop-color="#f9808a"></stop>
              <stop offset="1" stop-color="#6242e0"></stop>
            </linearGradient>
          </defs>
          <g fill="none" stroke-width="1.5">
            <path d="M110 44V90" stroke="#72b1ad"></path>
            <path d="M260 44V90" stroke="#72b1ad"></path>
            <path d="M410 44V90" stroke="#f0566d"></path>
            <path d="M110 98V146" stroke="#72b1ad"></path>
            <path d="M260 98V146" stroke="#72b1ad"></path>
          </g>
          <g fill="#0d0d10" stroke="#514856" stroke-width="1">
            <rect x="74" y="8" width="72" height="36" rx="4"></rect>
            <rect x="224" y="8" width="72" height="36" rx="4"></rect>
            <rect x="374" y="8" width="72" height="36" rx="4"></rect>
            <rect x="74" y="146" width="72" height="36" rx="4"></rect>
            <rect x="224" y="146" width="72" height="36" rx="4"></rect>
          </g>
          <rect x="374" y="146" width="72" height="36" rx="4" fill="none" stroke="#514856" stroke-dasharray="7 3"></rect>
          <g font-family="JetBrains Mono, monospace" font-size="10" letter-spacing=".8" text-anchor="middle" fill="#aaa5ac">
            <text x="110" y="30">AGENT</text>
            <text x="260" y="30">APP</text>
            <text x="410" y="30">LLM</text>
            <text x="110" y="168">DATA</text>
            <text x="260" y="168">DATA</text>
            <text x="410" y="168" fill="#655d69">DATA</text>
          </g>
          <rect x="16" y="91" width="488" height="6" rx="3" fill="url(#ov-warm-hero)"></rect>
          <circle cx="410" cy="94" r="5" fill="#0c050f" stroke="#f0566d" stroke-width="1.5"></circle>
          <circle cx="110" cy="94" r="5" fill="#0c050f" stroke="#72b1ad" stroke-width="1.5"></circle>
          <circle cx="260" cy="94" r="5" fill="#0c050f" stroke="#72b1ad" stroke-width="1.5"></circle>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .ov {
    --ink: #f8f7f8; /* stone-025 */
    --muted: #aaa5ac; /* stone-300 */
    --faint: #8e8891; /* stone-400 */
    --rule: #2a2130; /* stone-850 */
    --ground: #0c050f; /* stone-975 */
    --panel: #170d1c; /* stone-950 */
    --warm-hero: linear-gradient(100deg, #ffb370 0%, #f9808a 50%, #6242e0 100%);
    --inter: "Inter", ui-sans-serif, system-ui, sans-serif;
    --mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .ov-board {
    overflow: hidden;
    border-radius: 0.5rem;
    background: var(--ground);
    color: var(--ink);
    font-family: var(--inter);
    padding: 1.75rem 1.25rem 2rem;
  }
  @media (min-width: 768px) {
    .ov-board {
      padding: 2rem;
    }
  }
  .ov-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-bottom: 1.25rem;
  }
  .ov-title {
    font-size: clamp(1.375rem, 2.4vw, 2rem);
    line-height: 1.1;
  }
  .ov-link {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    padding: 0.625rem 1.125rem;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--warm-hero);
  }
  .ov-link::before {
    content: "";
    position: absolute;
    inset: 2px;
    z-index: -1;
    border-radius: inherit;
    background: var(--ground);
    transition: opacity 0.2s;
  }
  .ov-link:hover::before {
    opacity: 0;
  }

  .ov-grid {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 768px) {
    .ov-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .ov-voice { grid-column: span 7; }
    .ov-color { grid-column: span 5; }
    .ov-grads { grid-column: span 4; }
    .ov-type { grid-column: span 3; }
    .ov-diagram { grid-column: span 5; }
  }
  .ov-cell {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    background: var(--panel);
  }
  .ov-label {
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--faint);
  }

  /* Voice: the live homepage hero, one light line and one semibold */
  .ov-voice {
    justify-content: center;
    padding: 2rem 1.5rem;
    background:
      radial-gradient(ellipse 80% 70% at 100% 100%, rgb(240 86 109 / 0.18), transparent 70%),
      radial-gradient(ellipse 70% 70% at 80% 0%, rgb(98 66 224 / 0.18), transparent 70%),
      var(--panel);
  }
  @media (min-width: 768px) {
    .ov-voice { padding: 2.5rem; }
  }
  .ov-h {
    font-size: clamp(1.875rem, 4vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }
  .ov-sub {
    font-size: clamp(0.9375rem, 1.3vw, 1.125rem);
    font-weight: 300;
    color: var(--muted);
  }

  /* Color: every ramp as one continuous strip */
  .ov-ramps {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.375rem;
    min-height: 11rem;
  }
  /* A hairline between stops and around each ramp, so the darkest stops (and
     the 950/975 pairs that are identical by design) still read as cells on
     the dark panel instead of melting into it. */
  .ov-ramp {
    display: grid;
    grid-auto-rows: 1fr;
    gap: 1px;
    overflow: hidden;
    border-radius: 0.375rem;
    background: #3f3644; /* stone-800 */
    outline: 1px solid rgb(248 247 248 / 0.1);
    outline-offset: -1px;
  }

  .ov-glyphs {
    display: flex;
    gap: 0.5rem;
    font-size: clamp(2.5rem, 4.4vw, 3.75rem);
    line-height: 1;
  }

  .ov-glyph-mono {
    font-family: var(--mono);
    font-weight: 300;
    color: #ffb370; /* sand-300 */
  }
  .ov-grad {
    flex: 1;
    min-height: 3.5rem;
    border-radius: 0.375rem;
  }
  .ov-grads {
    gap: 0.625rem;
  }
  .ov-grads .ov-label {
    margin-top: 0.875rem;
  }

  .ov-diagram svg {
    width: 100%;
    height: auto;
  }
  @media (max-width: 639px) {
    .ov-diagram text {
      font-size: 15px;
      letter-spacing: 0;
    }
  }
</style>
