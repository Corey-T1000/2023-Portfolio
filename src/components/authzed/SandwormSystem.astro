---
// Sandworm in use, on real shipped surfaces: the live authzed.com homepage and
// docs site, and Base Layer's cover and guest cards.
// Drops into a `grid-cols-6` case-study row.
import { Image } from "astro:assets";

import cover from "../../assets/authzed/authzedSwBaseLayerCover.jpg";
import docsHome from "../../assets/authzed/authzedSwDocsHomeLive@2x.jpg";
import emilie from "../../assets/authzed/authzedSwSpeaker-emilie-schario.jpg";
import spencer from "../../assets/authzed/authzedSwSpeaker-spencer-kimball.jpg";
import taylor from "../../assets/authzed/authzedSwSpeaker-taylor-dolezal.jpg";
import zac from "../../assets/authzed/authzedSwSpeaker-zac-smith.jpg";

const speakers = [
  { src: zac, name: "Zachary Smith, Datum" },
  { src: emilie, name: "Emilie Schario, Kilo Code" },
  { src: spencer, name: "Spencer Kimball, Cockroach Labs" },
  { src: taylor, name: "Taylor Dolezal, Dosu" },
];
---

<figure class="col-span-full px-8 pb-4 sm:px-4" aria-label="The Sandworm design system on shipped surfaces">
  <div class="sw-top">
    <div class="sw-tile">
      <video
        class="sw-home"
        data-inview
        muted
        loop
        playsinline
        preload="metadata"
        poster="/video/authzed/homepage-live-poster.jpg"
        aria-label="The authzed.com homepage as it is live today: AI Moves Fast, Permissions Must Keep Up, beside the animated hero diagram where requests from RAG, LLM, agent, app and data warehouse nodes cross the AuthZed bar on the way to your data"
      >
        <source src="/video/authzed/homepage-live.webm" type="video/webm" />
        <source src="/video/authzed/homepage-live.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="sw-tile sw-docs">
      <Image
        src={docsHome}
        widths={[600, 900, 1400]}
        sizes="(min-width: 768px) 30vw, 100vw"
        alt="The AuthZed docs site, in its dark theme: the Writing Relationships page with the sidebar, a schema code block and a table of contents"
      />
    </div>
  </div>
  <div class="sw-podcast">
    <div class="sw-cover-wrap">
      <Image
        src={cover}
        widths={[300, 600]}
        sizes="(min-width: 768px) 15vw, 100vw"
        class="sw-cover"
        alt="The Base Layer show cover: base layer in large monospace type, split by a warm gradient line, from AuthZed"
      />
      <button class="sw-sting" type="button" aria-pressed="false" aria-label="Play the Base Layer audio sting" title="Play the audio sting">
        <svg class="sw-sting-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L13 8z" fill="currentColor"></path></svg>
        <svg class="sw-sting-stop" viewBox="0 0 16 16" aria-hidden="true"><rect x="4" y="4" width="8" height="8" rx="1" fill="currentColor"></rect></svg>
      </button>
      <audio class="sw-sting-audio" src="/video/authzed/base-layer-sting.mp3" preload="none"></audio>
    </div>
    <ul class="sw-speakers">
      {
        speakers.map((s) => (
          <li>
            <Image src={s.src} widths={[400, 800]} sizes="(min-width: 768px) 25vw, 50vw" alt={`Base Layer guest card: ${s.name}`} />
          </li>
        ))
      }
    </ul>
  </div>
  <figcaption class="pt-2 text-xs font-light text-neutral-500">
    Live applications and evolutions using the Sandworm design system.
  </figcaption>
</figure>

<style>
  .sw-top {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 768px) {
    .sw-top {
      grid-template-columns: 2.44fr 1fr;
    }
  }
  .sw-tile {
    overflow: hidden;
    min-width: 0;
    border-radius: 0.5rem;
    background: #0c050f; /* stone-975, palette.md */
  }
  .sw-tile :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .sw-home {
    display: block;
    width: 100%;
    aspect-ratio: 2880 / 1088;
    object-fit: cover;
    object-position: top;
  }
  /* The docs page is cropped to the homepage's height, from its top left. */
  .sw-docs {
    position: relative;
    aspect-ratio: 5 / 4;
  }
  .sw-docs :global(img) {
    position: absolute;
    inset: 0;
    object-fit: cover;
    object-position: left top;
  }
  @media (min-width: 768px) {
    .sw-docs {
      aspect-ratio: auto;
    }
  }
  .sw-podcast {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding: 0.75rem;
    border-radius: 0.5rem;
    background: #0c050f; /* stone-975 */
  }
  @media (min-width: 768px) {
    .sw-podcast {
      grid-template-columns: 1fr 8fr;
      align-items: center;
    }
  }
  .sw-cover-wrap {
    position: relative;
    width: 100%;
    max-width: 14rem;
  }
  .sw-podcast :global(.sw-cover) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.375rem;
  }
  .sw-sting {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: #f8f7f8; /* stone-025 */
    color: #0c050f; /* stone-975 */
    box-shadow: 0 1px 6px rgb(0 0 0 / 0.45);
    transition: background 0.2s;
  }
  .sw-sting:hover {
    background: #ffb370;
  }
  .sw-sting svg {
    width: 1rem;
    height: 1rem;
  }
  .sw-sting-stop,
  .sw-sting[aria-pressed="true"] .sw-sting-play {
    display: none;
  }
  .sw-sting[aria-pressed="true"] .sw-sting-stop {
    display: block;
  }
  .sw-speakers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 768px) {
    .sw-speakers {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .sw-speakers :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.375rem;
  }
</style>

<script>
  // Sound only when someone asks for it.
  document.addEventListener("astro:page-load", () => {
    const button = document.querySelector<HTMLButtonElement>(".sw-sting");
    const audio = document.querySelector<HTMLAudioElement>(".sw-sting-audio");
    if (!button || !audio) return;
    const label = (on: boolean) => {
      button.setAttribute("aria-pressed", String(on));
      button.setAttribute("aria-label", on ? "Stop the Base Layer audio sting" : "Play the Base Layer audio sting");
    };
    button.addEventListener("click", () => {
      if (audio.paused) {
        audio.currentTime = 0;
        audio.play().catch(() => label(false));
      } else {
        audio.pause();
      }
    });
    audio.addEventListener("play", () => label(true));
    audio.addEventListener("pause", () => label(false));
  });
</script>
