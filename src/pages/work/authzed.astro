    outline-offset: -2px;
  }
  .film-stage {
    flex: 0 0 min(78vw, 22rem);
    scroll-snap-align: start;
  }
  .film :global(.film-media) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    background: #0c050f;
    border-radius: 0.5rem;
    border: 1px solid rgb(var(--n-200));
  }
</style>

<script>
  import { initSpinMark } from "../../components/authzed/spin-marks";

  // The marks draw live over their poster and can be dragged.
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>(".spin-mark").forEach((el) => {
      const mark = el.dataset.mark as "N3" | "F0" | "B2";
      initSpinMark(el, mark, { label: el.getAttribute("aria-label") ?? "" });
    });
  });

  // Clips play only while on screen, and stay on their poster frames
  // under reduced motion.
  document.addEventListener("astro:page-load", () => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        });
      },
      { threshold: 0.4 },
    );
    document.querySelectorAll("video[data-inview]").forEach((v) => io.observe(v));
  });
</script>
